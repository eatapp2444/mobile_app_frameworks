{
  "name": "eatapp-framework",
  "version": "3.6.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "node scripts/fetch-config.js && expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "doctor": "npx expo-doctor",
    "sync-config": "node scripts/fetch-config.js",
    "eas-build-pre-install": "node scripts/fetch-config.js",
    "test": "jest --ci && tsx --test src/*.test.ts && node --test plugins/*.test.js && npm run check:nav-links -- scripts/nav-link-fixtures/fenwick-multi.json scripts/nav-link-fixtures/order-online-single.json scripts/nav-link-fixtures/order-online-multi.json",
    "check:nav-links": "tsx scripts/check-nav-links.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.8",
    "expo-font": "~14.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.4",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-tracking-transparency": "~6.0.7",
    "onesignal-expo-plugin": "^2.0.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-onesignal": "^5.2.9",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "sp-react-native-in-app-updates": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
