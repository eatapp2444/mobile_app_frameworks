{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "20.19.4",
      "env": {
        "EATAPP_API_URL": "https://mobileforge-studio.lovable.app/api/public/apps/config"
      },
      "ios": { "image": "sdk-54" },
      "android": { "image": "latest" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "sdk-54", "simulator": true },
      "android": { "image": "latest", "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "image": "sdk-54" },
      "android": { "image": "latest", "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "env": {
        "EATAPP_BUNDLE_ID": "com.jaihoindia",
        "EATAPP_SLUG": "jai-ho-indian-restaurant",
        "EATAPP_APP_NAME": "Jai Ho Indian",
        "EATAPP_VERSION": "4.0.2",
        "EATAPP_BUILD_NUMBER": "7",
        "EAS_PROJECT_ID": "b4bea2c5-5410-4762-8f8e-bff64a4f5910",
        "EATAPP_EAS_PROJECT_ID": "b4bea2c5-5410-4762-8f8e-bff64a4f5910",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "ios": { "image": "sdk-54", "resourceClass": "m-medium" },
      "android": { "image": "latest", "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "completed" }
    }
  }
}
