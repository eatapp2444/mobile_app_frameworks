{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "20.19.4",
      "env": {
        "EATAPP_API_URL": "https://mobileforge-studio.lovable.app/api/public/apps/config"
      },
      "ios": { "image": "sdk-54" },
      "android": { "image": "latest" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "sdk-54", "simulator": true },
      "android": { "image": "latest", "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "image": "sdk-54" },
      "android": { "image": "latest", "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "ios": { "image": "sdk-54", "resourceClass": "m-medium" },
      "android": { "image": "latest", "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "completed" }
    }
  }
}
